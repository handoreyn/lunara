<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Lunara.Moderation.Domain\Lunara.Moderation.Domain.csproj" />
    <ProjectReference Include="..\Lunara.Moderation.Application\Lunara.Moderation.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA1812: internal repository classes are instantiated by the DI container at runtime -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

</Project>
