<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Lunara.Worker-67bad459-42a7-45b8-8d0d-bba80fb458ce</UserSecretsId>
    <!-- CA1812: DI-registered hosted service types are instantiated via reflection -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lunara.Infrastructure.Host\Lunara.Infrastructure.Host.csproj" />
    <ProjectReference Include="..\Lunara.SharedKernel\Lunara.SharedKernel.csproj" />
  </ItemGroup>
</Project>
