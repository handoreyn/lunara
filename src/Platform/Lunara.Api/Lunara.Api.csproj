<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Required by EF Core CLI tools when this is the startup project for migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lunara.Infrastructure.Host\Lunara.Infrastructure.Host.csproj" />
    <ProjectReference Include="..\Lunara.SharedKernel\Lunara.SharedKernel.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CA1812: internal types instantiated by the minimal API JSON binder at runtime -->
    <NoWarn>CA1812</NoWarn>
  </PropertyGroup>

</Project>
